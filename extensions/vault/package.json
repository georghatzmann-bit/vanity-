{
  "name": "@aegis/vault-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEGIS Tresor: Browser-Erweiterung (Manifest V3) – füllt Logins aus dem AEGIS-Tresor aus, speichert selbst nichts.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
