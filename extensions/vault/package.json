    "test:e2e": "node scripts/build.mjs && playwright test"
  },
  "dependencies": {
    "@aegis/ui": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
