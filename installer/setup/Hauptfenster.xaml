<!-- Das Fenster des Installers: 760 x 480, rahmenlos, Ecken 12 px rund, mit weichem Schatten.
     Links Jarvis' Kern (Kugel mit Fortschrittsbogen), rechts die Seiten
     Start, Fortschritt, Fertig und Fehler. -->
<Window x:Class="JarvisSetup.Hauptfenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis Setup"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary Source="Design.xaml" />
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskleiste" />
    </Window.TaskbarItemInfo>

    <!-- Rand für den Schatten -->
    <Grid x:Name="Wurzel" Margin="24"
          TextElement.FontFamily="{StaticResource SchriftText}"
          TextElement.FontSize="14"
          TextElement.Foreground="{StaticResource Text}"
          KeyboardNavigation.TabNavigation="Cycle">

        <Border Width="760" Height="480" CornerRadius="12" Background="#0D0F13">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Karte" Width="760" Height="480" RenderOptions.ClearTypeHint="Enabled">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,760,480" RadiusX="12" RadiusY="12" />
            </Grid.Clip>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{StaticResource Hintergrund}" />

            <!-- Links: Jarvis' Kern -->
            <Grid x:Name="Buehne" Grid.RowSpan="2" Background="Transparent" MouseLeftButtonDown="Ziehen">
                <Canvas x:Name="KernFlaeche" Width="240" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0">
                    <Ellipse x:Name="KernGlanz" Width="240" Height="240" Fill="{StaticResource KernGlanzFarbe}" Opacity="0.8" />
                    <Ellipse x:Name="BogenSpur" Canvas.Left="38" Canvas.Top="38" Width="164" Height="164" Stroke="#12FFFFFF" StrokeThickness="2" Opacity="0" />
                    <Path x:Name="Bogen" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0">
                        <Path.Stroke>
                            <SolidColorBrush x:Name="BogenFarbe" Color="#9AABFF" />
                        </Path.Stroke>
                    </Path>
                    <Grid x:Name="Kugel" Canvas.Left="60" Canvas.Top="60" Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="KugelSkala" />
                        </Grid.RenderTransform>
                        <!-- Eine ruhige Kugel aus feinen Linien wie im Jarvis-Fenster (Hauptfenster.xaml.cs, KugelFormen):
                             hinten nur angedeutet, vorne klar -->
                        <Ellipse Fill="{StaticResource KugelInnen}" Margin="6" />
                        <Path x:Name="KugelHinten" Stroke="#E2E6F0" StrokeThickness="1" Opacity="0.09" StrokeLineJoin="Round" />
                        <Path x:Name="KugelMitte" Stroke="#E2E6F0" StrokeThickness="1" Opacity="0.26" StrokeLineJoin="Round" />
                        <Path x:Name="KugelVorn" Stroke="#E6EAF6" StrokeThickness="1" Opacity="0.58" StrokeLineJoin="Round" />
                    </Grid>
                </Canvas>
                <TextBlock x:Name="VersionText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24"
                           Style="{StaticResource Klein}" Text="Version 2.0.0" />
            </Grid>

            <!-- Rechts: die Seiten -->
            <Grid x:Name="Seiten" Grid.Row="1" Grid.Column="1" Margin="8,8,32,32">

                <!-- Start -->
                <Grid x:Name="SeiteStart">
                    <StackPanel>
                        <TextBlock x:Name="StartTitel" Style="{StaticResource Titel}" Text="Jarvis installieren" />
                        <TextBlock x:Name="StartSatz" Style="{StaticResource Satz}" Margin="0,8,0,0"
                                   Text="Der Installer holt alles Nötige selbst und richtet Jarvis in wenigen Minuten ein." />
                        <Button x:Name="KnopfInstallieren" Style="{StaticResource KnopfPrimaer}" Margin="0,24,0,0" Content="Installieren"
                                IsDefault="True" Click="Installieren_Click" />
                        <Border Margin="0,16,0,0" Background="{StaticResource Flaeche1}" BorderBrush="{StaticResource Linie}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <CheckBox x:Name="SchalterAutostart" Style="{StaticResource Schalter}" IsChecked="True"
                                          AutomationProperties.Name="Mit Windows starten"
                                          AutomationProperties.HelpText="Jarvis läuft unsichtbar im Hintergrund und hört auf Hey Jarvis.">
                                    <StackPanel>
                                        <TextBlock Text="Mit Windows starten" Foreground="{StaticResource Text}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Nebentext}" TextWrapping="Wrap"
                                                   Text="Jarvis läuft unsichtbar im Hintergrund und hört auf „Hey Jarvis“." />
                                    </StackPanel>
                                </CheckBox>
                                <Border Height="1" Margin="16,0" Background="{StaticResource Linie}" />
                                <CheckBox x:Name="SchalterDesktop" Style="{StaticResource Schalter}" IsChecked="False"
                                          AutomationProperties.Name="Symbol auf dem Desktop"
                                          AutomationProperties.HelpText="Für den schnellen Start per Doppelklick.">
                                    <StackPanel>
                                        <TextBlock Text="Symbol auf dem Desktop" Foreground="{StaticResource Text}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Nebentext}" TextWrapping="Wrap"
                                                   Text="Für den schnellen Start per Doppelklick." />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Grid x:Name="LaeuftHinweis" Margin="0,16,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Ellipse Width="16" Height="16" Stroke="{StaticResource AkzentHell}" StrokeThickness="1.4" />
                                <Path Data="M8,7.2 L8,11.6" Stroke="{StaticResource AkzentHell}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="7.1" Canvas.Top="3.9" Width="1.8" Height="1.8" Fill="{StaticResource AkzentHell}" />
                            </Canvas>
                            <TextBlock x:Name="LaeuftHinweisText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Nebentext}" TextWrapping="Wrap"
                                       Text="Jarvis läuft gerade. Er wird kurz beendet und danach neu gestartet." />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="PlatzSymbol" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" Visibility="Collapsed">
                                <Ellipse Width="16" Height="16" Fill="#2EF2A44B" />
                                <Path Data="M8,4.2 L8,9" Stroke="{StaticResource Warnung}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="7.05" Canvas.Top="10.6" Width="1.9" Height="1.9" Fill="{StaticResource Warnung}" />
                            </Canvas>
                            <TextBlock x:Name="PlatzText" Grid.Column="1" Style="{StaticResource Klein}" Text="Braucht etwa 3 GB Speicherplatz." />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Fortschritt -->
                <Grid x:Name="SeiteFortschritt" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="FortschrittTitel" Style="{StaticResource Titel}" Text="Jarvis wird installiert" />
                        <TextBlock x:Name="FortschrittSatz" Style="{StaticResource Satz}" Margin="0,8,0,0"
                                   Text="Das dauert beim ersten Mal ein paar Minuten." />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <ItemsControl x:Name="SchrittListe" ItemTemplate="{StaticResource SchrittVorlage}" Focusable="False" />
                        <Border x:Name="DetailsFlaeche" Background="{StaticResource Flaeche1}" BorderBrush="{StaticResource Linie}" BorderThickness="1"
                                CornerRadius="10" Padding="12,8" Visibility="Collapsed" RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="DetailsSkala" ScaleY="0" />
                            </Border.RenderTransform>
                            <ItemsControl x:Name="DetailsZeilen" ItemTemplate="{StaticResource ProtokollVorlage}" Focusable="False" VerticalAlignment="Bottom" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ProzentText" Text="0 %" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="RestText" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12" Foreground="{StaticResource Nebentext}"
                                   Text="Restzeit wird berechnet" />
                        <Grid x:Name="BalkenSpur" Grid.Row="1" Height="4" Margin="0,8,0,0">
                            <Border Background="#14FFFFFF" CornerRadius="2" />
                            <Border x:Name="BalkenFuellung" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource Akzent}" />
                        </Grid>
                    </Grid>
                    <Button x:Name="KnopfDetails" Grid.Row="3" Style="{StaticResource KnopfText}" HorizontalAlignment="Left" Margin="-8,4,0,-12"
                            Click="Details_Click" AutomationProperties.Name="Details">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailsKnopfText" Text="Details" VerticalAlignment="Center" />
                            <Path Data="M0,0 L4,4 L8,0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Margin="8,2,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="DetailsPfeil" />
                                </Path.RenderTransform>
                            </Path>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Fertig -->
                <Grid x:Name="SeiteFertig" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="FertigTitel" Style="{StaticResource Titel}" Text="Jarvis ist bereit." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" HorizontalAlignment="Left">
                                <Ellipse Fill="#2E3FBF85" />
                                <Path Data="M4.6,8.3 L7,10.6 L11.4,5.8" Stroke="{StaticResource Erfolg}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                            <TextBlock x:Name="FertigZeile" Grid.Column="1" FontSize="12" Foreground="{StaticResource Nebentext}" VerticalAlignment="Center"
                                       Text="Alle sechs Schritte sind fertig." />
                        </Grid>
                        <TextBlock x:Name="FertigSatz" Style="{StaticResource Satz}" Margin="0,16,0,0"
                                   Text="Beim ersten Start öffnet sich die Einrichtung: Mikrofon, Stimme und die Anmeldung für das Gehirn." />
                        <ItemsControl x:Name="FertigHinweise" Margin="0,16,0,0" ItemTemplate="{StaticResource HinweisVorlage}" Focusable="False" Visibility="Collapsed" />
                        <Button x:Name="KnopfStarten" Style="{StaticResource KnopfPrimaer}" Margin="0,24,0,0" Content="Jarvis starten" Click="Starten_Click" />
                        <Button x:Name="KnopfFertigSchliessen" Style="{StaticResource KnopfSekundaer}" Margin="0,12,0,0" Content="Schließen" Click="Schliessen_Click" />
                    </StackPanel>
                </Grid>

                <!-- Fehler -->
                <Grid x:Name="SeiteFehler" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Titel}" Text="Das hat nicht geklappt." />
                        <Grid x:Name="FehlerSchrittZeile" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" HorizontalAlignment="Left">
                                <Ellipse Fill="#2EF2645F" />
                                <Path Data="M5.6,5.6 L10.4,10.4 M10.4,5.6 L5.6,10.4" Stroke="{StaticResource Fehler}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <TextBlock x:Name="FehlerSchrittText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Nebentext}" VerticalAlignment="Center"
                                       Text="Schritt 3 von 6: Pakete" />
                        </Grid>
                        <Border Margin="0,16,0,0" Background="{StaticResource Flaeche1}" BorderBrush="{StaticResource Linie}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="FehlerMeldung" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                           Text="Keine Verbindung zum Internet." />
                                <TextBlock x:Name="FehlerTipp" Style="{StaticResource Satz}" Margin="0,8,0,0"
                                           Text="Prüfen Sie WLAN oder Netzwerkkabel und klicken Sie dann auf „Nochmal versuchen“." />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="KnopfNochmal" Style="{StaticResource KnopfPrimaer}" Padding="12,0" Content="Nochmal versuchen" Click="Nochmal_Click" />
                            <Button x:Name="KnopfProtokoll" Grid.Column="2" Style="{StaticResource KnopfSekundaer}" Height="48" Padding="12,0"
                                    Content="Protokoll öffnen" Click="Protokoll_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Titelleiste: ziehen, minimieren, schließen (im Baum nach den Seiten: Tab kommt zuletzt hierher) -->
            <Grid x:Name="Titelleiste" Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="Ziehen">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Width="11" Height="11" Stretch="Uniform" Stroke="#C8CEE0" StrokeThickness="0.8" VerticalAlignment="Center"
                          Data="M9.60,5.00 L9.56,5.60 L9.44,6.19 L9.25,6.76 L8.98,7.30 L8.65,7.80 L8.25,8.25 L7.80,8.65 L7.30,8.98 L6.76,9.25 L6.19,9.44 L5.60,9.56 L5.00,9.60 L4.40,9.56 L3.81,9.44 L3.24,9.25 L2.70,8.98 L2.20,8.65 L1.75,8.25 L1.35,7.80 L1.02,7.30 L0.75,6.76 L0.56,6.19 L0.44,5.60 L0.40,5.00 L0.44,4.40 L0.56,3.81 L0.75,3.24 L1.02,2.70 L1.35,2.20 L1.75,1.75 L2.20,1.35 L2.70,1.02 L3.24,0.75 L3.81,0.56 L4.40,0.44 L5.00,0.40 L5.60,0.44 L6.19,0.56 L6.76,0.75 L7.30,1.02 L7.80,1.35 L8.25,1.75 L8.65,2.20 L8.98,2.70 L9.25,3.24 L9.44,3.81 L9.56,4.40 L9.60,5.00 M7.71,8.71 L7.54,8.83 L7.33,8.95 L7.07,9.05 L6.78,9.14 L6.47,9.21 L6.12,9.27 L5.76,9.31 L5.38,9.34 L5.00,9.35 L4.62,9.34 L4.24,9.31 L3.88,9.27 L3.53,9.21 L3.22,9.14 L2.93,9.05 L2.67,8.95 L2.46,8.83 L2.29,8.71 M9.34,6.53 L9.23,6.73 L9.04,6.92 L8.79,7.10 L8.47,7.27 L8.09,7.42 L7.66,7.55 L7.19,7.67 L6.67,7.75 L6.13,7.82 L5.57,7.86 L5.00,7.87 L4.43,7.86 L3.87,7.82 L3.33,7.75 L2.81,7.67 L2.34,7.55 L1.91,7.42 L1.53,7.27 L1.21,7.10 L0.96,6.92 L0.77,6.73 L0.66,6.53 M9.37,3.67 L9.34,3.87 L9.23,4.07 L9.04,4.26 L8.79,4.44 L8.47,4.61 L8.09,4.76 L7.66,4.89 L7.19,5.00 L6.67,5.09 L6.13,5.16 L5.57,5.20 L5.00,5.21 L4.43,5.20 L3.87,5.16 L3.33,5.09 L2.81,5.00 L2.34,4.89 L1.91,4.76 L1.53,4.61 L1.21,4.44 L0.96,4.26 L0.77,4.07 L0.66,3.87 L0.63,3.67 L0.66,3.47 M7.93,1.68 L7.91,1.82 L7.83,1.95 L7.71,2.08 L7.54,2.20 L7.33,2.31 L7.07,2.41 L6.78,2.50 L6.47,2.58 L6.12,2.64 L5.76,2.68 L5.38,2.71 L5.00,2.72 L4.62,2.71 L4.24,2.68 L3.88,2.64 L3.53,2.58 L3.22,2.50 L2.93,2.41 L2.67,2.31 L2.46,2.20 L2.29,2.08 L2.17,1.95 L2.09,1.82 L2.07,1.68 L2.09,1.55 L2.17,1.42 L2.29,1.29 L2.46,1.17" />
                    <TextBlock Margin="8,0,0,0" Style="{StaticResource Klein}" Text="Jarvis Setup" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource KnopfTitel}" Click="Minimieren_Click" ToolTip="Minimieren" AutomationProperties.Name="Minimieren">
                        <Path Data="M0,0.5 L10,0.5" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource KnopfSchliessen}" Click="SchliessenTitel_Click" ToolTip="Schließen" AutomationProperties.Name="Schließen">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Rückfrage beim Abbrechen -->
            <Grid x:Name="Rueckfrage" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Opacity="0">
                <Border Background="#D90D0F13" />
                <Border x:Name="RueckfrageKarte" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                        Background="{StaticResource Flaeche1}" BorderBrush="{StaticResource Linie}" BorderThickness="1" CornerRadius="12"
                        RenderTransformOrigin="0.5,0.5" KeyboardNavigation.TabNavigation="Cycle">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="RueckfrageSkala" ScaleX="0.97" ScaleY="0.97" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="RueckfrageTitel" FontFamily="{StaticResource SchriftTitel}" FontSize="18" FontWeight="SemiBold"
                                   TextOptions.TextFormattingMode="Ideal" Text="Installation abbrechen?" />
                        <TextBlock x:Name="RueckfrageText" Style="{StaticResource Satz}" Margin="0,8,0,0"
                                   Text="Was schon geladen ist, bleibt erhalten. Sie können später einfach weitermachen." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button x:Name="KnopfAbbrechenJa" Style="{StaticResource KnopfSekundaer}" Padding="16,0" Margin="0,0,12,0"
                                    Content="Abbrechen" Click="AbbrechenJa_Click" />
                            <Button x:Name="KnopfWeiter" Style="{StaticResource KnopfPrimaer}" Height="44" Padding="16,0"
                                    Content="Weiter installieren" Click="Weiter_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Feine Linie um das ganze Fenster -->
            <Border Grid.RowSpan="2" Grid.ColumnSpan="2" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Linie}" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
