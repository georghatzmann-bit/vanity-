<Project Sdk="Microsoft.NET.Sdk">
  <!-- Die Oberfläche des Installers: ein kleines WPF-Programm für .NET Framework 4.7.2
       (auf Windows 10 ab 1809 und Windows 11 schon vorhanden, keine Extra-Laufzeit).
       Es bettet den Inno-Kern ein (..\Output\JarvisKern.exe, gebaut aus ..\jarvis.iss).
       Bauen: dotnet build installer\setup\JarvisSetup.csproj -c Release -p:KernPflicht=true -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>JarvisSetup</AssemblyName>
    <RootNamespace>JarvisSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>2.0.0</Version>
    <Product>Jarvis</Product>
    <Company>Jarvis</Company>
    <AssemblyTitle>Jarvis Setup</AssemblyTitle>
    <Description>Installiert Jarvis, den Sprachassistenten für Windows</Description>
    <Copyright>Jarvis</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <!-- Damit es auch unter Linux baut (nur zum Prüfen, laufen tut es nur unter Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\jarvis.ico')">
    <ApplicationIcon>..\jarvis.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Management" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Output\JarvisKern.exe" LogicalName="JarvisKern.exe" Condition="Exists('..\Output\JarvisKern.exe')" />
  </ItemGroup>

  <!-- Im Build auf GitHub muss der Kern dabei sein, sonst wäre JarvisSetup.exe leer. -->
  <Target Name="KernPruefen" BeforeTargets="BeforeBuild" Condition="'$(KernPflicht)' == 'true'">
    <Error Condition="!Exists('..\Output\JarvisKern.exe')" Text="installer\Output\JarvisKern.exe fehlt. Zuerst den Inno-Kern bauen: ISCC installer\jarvis.iss" />
  </Target>
</Project>
