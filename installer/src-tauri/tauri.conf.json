{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulsar Setup",
  "mainBinaryName": "Pulsar-Setup",
  "version": "1.0.0",
  "identifier": "com.pulsar.setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Pulsar Setup",
        "url": "index.html",
        "width": 980,
        "height": 640,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "backgroundColor": "#0A0B0D",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Pulsar",
    "copyright": "Pulsar",
    "shortDescription": "Pulsar Setup",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
