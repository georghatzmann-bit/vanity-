{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift",
  "mainBinaryName": "Rift",
  "version": "0.1.0",
  "identifier": "dev.rift.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rift",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#07070C"
      },
      {
        "label": "splash",
        "title": "Rift",
        "url": "splash.html",
        "width": 440,
        "height": 300,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Georg Hatzmann",
    "category": "Game",
    "shortDescription": "Launcher for OG Fortnite private servers",
    "copyright": "© 2026 Rift · GPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/assets/header.bmp",
        "sidebarImage": "windows/assets/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "resources": {
      "resources/dlls/*": "dlls/",
      "resources/backend/": "backend/",
      "resources/node/*": "node/"
    }
  }
}
