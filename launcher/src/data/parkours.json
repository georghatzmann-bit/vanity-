      "height": 25,
      "platform": [3, 3],
      "elements": [
        { "kind": "launcher", "at": [4, 0, 0] }
      ],
      "bots": [
        { "at": [40, -15, 0], "hp": 50 },
        { "at": [40, 15, 0], "hp": 50 }
      ]
    },
    {
      "id": "spin-360",
      "name": "360 Spin",
      "level": 2,
      "description": "The bot is close by – practise spins (360s) before the shot.",
      "height": 25,
      "platform": [3, 3],
      "elements": [
        { "kind": "launcher", "at": [5, 0, 0] }
      ],
      "bots": [
        { "at": [22, 0, 0], "hp": 50 }
      ]
    },
    {
      "id": "long-shot",
      "name": "Long Shot",
      "level": 3,
      "description": "Start high up; the bot stands far away and lower down. For long shots.",
      "height": 60,
      "platform": [3, 3],
      "elements": [
        { "kind": "trampoline", "at": [9, 0, -1] }
      ],
      "bots": [
        { "at": [120, 0, -25], "hp": 50 }
      ]
    },
    {
      "id": "jump-chain",
      "name": "Jump Chain",
      "level": 3,
