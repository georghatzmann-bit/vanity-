{
  "version": 1,
  "about": "Rift parkours: ready-made trickshot courses built from jump objects. All values are in metres relative to you: x = forward (where you look), y = right, z = up. For each object the server uses the first name your Fortnite version knows.",
  "kinds": {
    "trampoline": { "label": "Trampoline", "summon": ["tire", "umbrella"] },
    "launcher": { "label": "Launcher", "summon": ["geyser", "airvent", "ufobouncer"] },
    "sideLauncher": { "label": "Side launcher", "summon": ["ufobouncer", "geyser", "airvent"] }
  },
  "snipers": ["reaper_sr", "hunterbolt_sr", "heavy_sr", "bolt_sr", "hunting_sr", "semi"],
  "parkours": [
    {
      "id": "first-jump",
      "name": "First Jump",
      "level": 1,
      "description": "Run over the trampoline, fly up and hit the bot in front of you.",
      "height": 25,
      "platform": [3, 3],
      "elements": [
        { "kind": "trampoline", "at": [9, 0, -1] }
      ],
      "bots": [
        { "at": [40, 0, 0], "hp": 50 }
      ]
    },
    {
      "id": "geyser-shot",
      "name": "Geyser Shot",
      "level": 1,
      "description": "Step on the geyser and it shoots you up. Turn around up there and shoot.",
      "height": 25,
      "platform": [3, 3],
      "elements": [
        { "kind": "launcher", "at": [4, 0, 0] }
      ],
      "bots": [
        { "at": [55, 0, 0], "hp": 50 }
      ]
    },
    {
      "id": "trampoline-stairs",
      "name": "Trampoline Stairs",
      "level": 2,
      "description": "Four trampolines, each one a bit higher. Bounce from one to the next, then take the shot.",
      "height": 25,
      "platform": [3, 3],
      "elements": [
        { "kind": "trampoline", "at": [9, 0, -1] },
        { "kind": "trampoline", "at": [18, 0, 1] },
        { "kind": "trampoline", "at": [27, 0, 3] },
        { "kind": "trampoline", "at": [36, 0, 5] }
      ],
      "bots": [
        { "at": [70, 0, 0], "hp": 50 }
      ]
    },
    {
      "id": "double-target",
      "name": "Double Target",
      "level": 2,
