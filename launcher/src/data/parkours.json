      "platform": [5, 5],
      "elements": [
        { "kind": "launcher", "at": [0, -8, 0] },
        { "kind": "trampoline", "at": [8, 8, 0] }
      ],
      "bots": [
        { "at": [35, 0, 0], "hp": 50 },
        { "at": [-30, 20, 5], "hp": 50 },
        { "at": [0, -40, -5], "hp": 50 }
      ]
    }
  ]
}
