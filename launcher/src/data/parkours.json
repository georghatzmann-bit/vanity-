      "bots": [
        { "at": [32, 18, 4], "hp": 50 },
        { "at": [70, 0, 0], "hp": 50 }
      ]
    },
    {
      "id": "ground-course",
      "name": "Ground Course",
      "level": 1,
      "description": "Everything right in front of you on the ground – best started on a flat field.",
      "height": 0,
      "platform": [0, 0],
      "elements": [
        { "kind": "trampoline", "at": [8, 0, 0] },
        { "kind": "launcher", "at": [16, 0, 0] }
