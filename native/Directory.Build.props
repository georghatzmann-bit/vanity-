<Project>
  <!-- Shared output of all projects: DLLs/libs go to native\bin\<Configuration>\,
       intermediate files separately per project to native\obj\<Project>\<Configuration>\.
       Important: $(MSBuildProjectName) instead of $(ProjectName) – the latter is still empty here, then all
       projects share one vc143.pdb and the parallel build fails with C1041. -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(MSBuildProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>
</Project>
