<Project>
  <!-- Gemeinsame Ausgabe aller Projekte: DLLs/Libs nach native\bin\<Konfiguration>\,
       Zwischendateien getrennt je Projekt nach native\obj\<Projekt>\<Konfiguration>\.
       Wichtig: $(MSBuildProjectName) statt $(ProjectName) – letzteres ist hier noch leer, dann teilen
       sich alle Projekte eine vc143.pdb und der parallele Build bricht mit C1041 ab. -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(MSBuildProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>
</Project>
