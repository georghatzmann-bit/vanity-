{
  "category": "debloat",
  "tweaks": [
    {
      "id": "debloat.copilot-off",
      "name": "Copilot in Windows aus",
      "desc": "Schaltet den Copilot-Seitenbereich ab und blendet den Copilot-Knopf in der Taskleiste aus. Copilot ist danach nicht mehr erreichbar.",
      "info": "Wirkt auf den eingebauten Copilot von Windows 10 22H2 und Windows 11 22H2/23H2. Die neue Copilot-App ist eine normale App – die entfernst du unter „Bloatware“. Microsoft führt die Richtlinie als veraltet.",
      "group": "Copilot & KI",
      "kind": "toggle",
      "impact": 1,
      "risk": "moderate",
      "warning": "Der Copilot-Seitenbereich und der Copilot-Knopf in der Taskleiste stehen danach nicht mehr zur Verfügung.",
      "needs": "explorer",
      "tags": [
        "ai",
        "bloat"
      ],
      "actions": [
        {
          "type": "reg",
          "path": "HKCU\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot",
          "name": "TurnOffWindowsCopilot",
          "kind": "DWord",
          "value": 1,
          "default": null
        },
        {
          "type": "reg",
          "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "ShowCopilotButton",
          "kind": "DWord",
          "value": 0,
          "default": null
        }
      ]
    },
    {
      "id": "debloat.copilot-context-menu-off",
      "name": "„Copilot fragen“ im Rechtsklickmenü ausblenden",
      "desc": "Entfernt den Eintrag „Copilot fragen“, den die Copilot-App ins Rechtsklickmenü des Explorers einbaut. Die App selbst bleibt.",
      "info": "Blockiert nur die Shell-Erweiterung der Copilot-App für dein Benutzerkonto. Ist die App nicht installiert, ändert sich nichts.",
      "group": "Copilot & KI",
      "kind": "toggle",
      "impact": 1,
      "risk": "safe",
      "warning": null,
      "needs": "explorer",
      "tags": [
        "ai",
        "explorer",
        "quality-of-life"
      ],
      "actions": [
        {
          "type": "reg",
          "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Shell Extensions\\Blocked",
          "name": "{CB3B0003-8088-4EDE-8769-8B354AB2FF8C}",
          "kind": "String",
          "value": "",
          "default": null
        }
      ]
    },
    {
      "id": "debloat.recall-snapshots-off",
      "name": "Recall: keine Bildschirm-Schnappschüsse",
      "desc": "Windows speichert keine Bildschirmfotos mehr für Recall, vorhandene werden gelöscht. Spart Speicher und Rechenzeit, schützt deine Daten.",
      "info": "Recall gibt es nur auf Copilot+ PCs mit Windows 11 24H2. Auf anderen PCs schadet die Einstellung nicht.",
      "group": "Copilot & KI",
      "kind": "toggle",
      "impact": 2,
      "risk": "moderate",
      "warning": "Nutzt du Recall, findet es danach nichts mehr – alle vorhandenen Schnappschüsse werden gelöscht.",
      "needs": "logoff",
      "tags": [
        "ai",
        "privacy",
        "storage"
      ],
      "when": {
        "minBuild": 26100
      },
      "actions": [
        {
          "type": "reg",
          "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
          "name": "DisableAIDataAnalysis",
          "kind": "DWord",
          "value": 1,
          "default": null
        },
        {
          "type": "reg",
          "path": "HKCU\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
          "name": "DisableAIDataAnalysis",
          "kind": "DWord",
          "value": 1,
          "default": null
        }
      ]
    },
    {
      "id": "debloat.recall-remove",
      "name": "Recall komplett entfernen",
      "desc": "Entfernt die Recall-Funktion ganz von Copilot+ PCs. Gespeicherte Schnappschüsse werden gelöscht.",
      "info": "Beim Zurücksetzen wird nur die Richtlinie gelöscht. Recall musst du dann selbst unter „Windows-Features aktivieren oder deaktivieren“ wieder einschalten.",
      "group": "Copilot & KI",
      "kind": "toggle",
      "impact": 2,
      "risk": "moderate",
      "warning": "Recall verschwindet vom PC, alle Schnappschüsse werden gelöscht. Zurück nur über „Windows-Features“.",
      "needs": "reboot",
      "tags": [
        "ai",
        "privacy",
        "bloat"
      ],
      "when": {
        "minBuild": 26100
      },
      "actions": [
        {
          "type": "reg",
          "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
          "name": "AllowRecallEnablement",
          "kind": "DWord",
          "value": 0,
          "default": null
        }
      ]
    },
