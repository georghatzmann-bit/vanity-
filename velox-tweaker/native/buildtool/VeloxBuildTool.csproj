<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build helper (runs on the build machine, .NET 8): packs payload.zip deterministically and
       verifies the finished VeloxSetup.exe. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- override the net472 settings of native/Directory.Build.props -->
    <ApplicationIcon></ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- the in-memory web server both exes use: verify runs it against the files embedded in the built exes -->
    <Compile Include="../shared/EmbeddedSite.cs" Link="shared/EmbeddedSite.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Remove="Microsoft.NETFramework.ReferenceAssemblies.net472" />
    <Reference Remove="System.Windows.Forms" />
    <Reference Remove="System.Drawing" />
  </ItemGroup>
</Project>
